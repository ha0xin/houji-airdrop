+static bool wma_pt_peer_dp_key_matches(const void *psoc, u8 vdev_id,
+				       const u8 *mac)
+{
+	return wma_pt_peer_trial.generation && wma_pt_peer_trial.psoc == psoc &&
+	       wma_pt_peer_trial.vdev_id == vdev_id &&
+	       !memcmp(wma_pt_peer_trial.mac, mac, QDF_MAC_ADDR_SIZE);
+}
+
+void pt_remote_peer_dp_event(const void *psoc, u8 vdev_id, const u8 *mac,
+			     u16 peer_id, enum pt_remote_peer_event event)
+{
+	unsigned long flags;
+
+	if (!READ_ONCE(wma_pt_peer_trial.generation))
+		return;
+
+	spin_lock_irqsave(&wma_pt_peer_lock, flags);
+	if (!wma_pt_peer_dp_key_matches(psoc, vdev_id, mac))
+		goto unlock;
+
+	if (!wma_pt_peer_trial.create_issued || peer_id == U16_MAX ||
+	    (wma_pt_peer_trial.htt_map && wma_pt_peer_trial.peer_id != peer_id)) {
+		wma_pt_peer_trial.dp_conflict = true;
+		goto unlock;
+	}
+
+	switch (event) {
+	case PT_REMOTE_HTT_MAP:
+		if (wma_pt_peer_trial.htt_unmap || wma_pt_peer_trial.slot_removed)
+			wma_pt_peer_trial.dp_conflict = true;
+		wma_pt_peer_trial.htt_map = true;
+		wma_pt_peer_trial.peer_id = peer_id;
+		break;
+	case PT_REMOTE_SLOT_INSTALL:
+		if (!wma_pt_peer_trial.htt_map || wma_pt_peer_trial.htt_unmap)
+			wma_pt_peer_trial.dp_conflict = true;
+		else
+			wma_pt_peer_trial.slot_installed = true;
+		break;
+	case PT_REMOTE_HTT_UNMAP:
+		if (!wma_pt_peer_trial.slot_installed)
+			wma_pt_peer_trial.dp_conflict = true;
+		else
+			wma_pt_peer_trial.htt_unmap = true;
+		break;
+	case PT_REMOTE_SLOT_REMOVE:
+		if (!wma_pt_peer_trial.slot_installed)
+			wma_pt_peer_trial.dp_conflict = true;
+		else
+			wma_pt_peer_trial.slot_removed = true;
+		break;
+	}
+
+unlock:
+	spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+}
+
+u64 pt_remote_peer_release_key(const void *psoc, u8 vdev_id, const u8 *mac)
+{
+	unsigned long flags;
+	u64 generation = 0;
+
+	if (!READ_ONCE(wma_pt_peer_trial.generation))
+		return 0;
+
+	spin_lock_irqsave(&wma_pt_peer_lock, flags);
+	if (wma_pt_peer_dp_key_matches(psoc, vdev_id, mac))
+		generation = wma_pt_peer_trial.generation;
+	spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+	return generation;
+}
+
+void pt_remote_peer_released(u64 generation, enum pt_remote_peer_object obj)
+{
+	unsigned long flags;
+
+	if (!generation)
+		return;
+
+	spin_lock_irqsave(&wma_pt_peer_lock, flags);
+	if (generation == wma_pt_peer_trial.generation) {
+		if (obj == PT_REMOTE_DP_OBJECT)
+			wma_pt_peer_trial.dp_released = true;
+		else
+			wma_pt_peer_trial.obj_released = true;
+	}
+	spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+}
+
 #endif
 
