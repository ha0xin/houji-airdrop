diff --git a/radio-owly.sh b/radio-owly.sh
--- a/radio-owly.sh
+++ b/radio-owly.sh
@@ -266,6 +266,7 @@
  check "$qca_sha" "$qca"
  printf '%s %s\n' "$qca_sha" "$qca" > "$STATE/candidate.tmp"
  mv "$STATE/candidate.tmp" "$STATE/candidate.sha"
+ echo trial > "$STATE/purpose"
  echo "WLAN_BUILD_SHA=$qca_sha BA_OBSERVER_REQUEST=$ba_mode"
  check 9d60988f896669604ff2e8cdfa1ba91a7047c1ddd2210b1fa494f506f5eb039c "$RADIO/wonder.ko"
  test "$(uname -r)" = 6.1.138-android14-11-g0c3d559bcd85-ab14529422
@@ -504,7 +505,7 @@
  job_lock
  token=$1
  for file in runner.log server.log before.txt after.txt; do rm -f "$STATE/$file"; done
- rm -f "$STATE/stop-$token" "$STATE/result" "$STATE/candidate.sha"
+ rm -f "$STATE/stop-$token" "$STATE/result" "$STATE/candidate.sha" "$STATE/purpose"
  echo "$token" > "$STATE/token"
  state PREFLIGHT
  trap finish_job EXIT
@@ -514,6 +515,49 @@
  # Each mutating step and the trial itself have deadlines. flock is
  # nonblocking so a foreign owner cannot stall recovery or be displaced.
  "$BB" flock -n "$NATIVE/supervisor.lock" sh "$0" locked "$@" 9>&-
+}
+
+rehearse_failure() {
+ rc=$?
+ trap - EXIT TERM INT HUP
+ set +e
+ if test "$rc" != 0 && test "$paused" = 1; then
+  "$BB" flock -n "$NATIVE/supervisor.lock" sh "$0" recover-locked 9>&-
+  recovery_rc=$?
+  if test "$recovery_rc" = 0; then resume_native; recovery_rc=$?; fi
+  if test "$recovery_rc" != 0; then state RESTORE_FAILED; rc=$recovery_rc; fi
+ fi
+ exit "$rc"
+}
+
+rehearse() {
+ job_lock
+ test ! -e "$STATE/saved.env"
+ test "$(cat "$STATE/status")" = STOCK_RESTORED
+ trap rehearse_failure EXIT
+ trap 'exit 143' TERM HUP
+ trap 'exit 130' INT
+ suspend_native
+ "$BB" flock -n "$NATIVE/supervisor.lock" sh "$0" rehearse-locked "$1" 9>&-
+}
+
+rehearse_locked() {
+ test ! -e "$STATE/saved.env"
+ no_native_bridge
+ stock_files
+ check d3fbe4f1b62f8c3533609945b617508e8a585660f5640aeeda08f8508416137b "$STOCK"
+ snapshot
+ printf '%s\n' "$1" > "$STATE/token"
+ printf '%s %s\n' d3fbe4f1b62f8c3533609945b617508e8a585660f5640aeeda08f8508416137b "$STOCK" > "$STATE/candidate.sha"
+ echo rehearsal > "$STATE/purpose"
+ cmd wifi set-wifi-enabled disabled
+ for i in $(seq 1 15); do
+  if test "$(settings get global wifi_on)" = 0; then break; fi
+  sleep 1
+ done
+ test "$(settings get global wifi_on)" = 0
+ echo "SYNTHETIC_REHEARSAL token=$1 wifi_on=0"
+ state RESTORE_FAILED
 }
 
 test "$(id -u)" = 0
@@ -547,6 +591,12 @@
   run_job "$2" vht80-sgi single ack - 0 0 0 500 caps
   ;;
  locked) shift; run_locked "$@" ;;
+ rehearse|rehearse-locked)
+  test "$#" = 2
+  case "$2" in rehearsal-*) ;; *) exit 2 ;; esac
+  case "$2" in *[!a-zA-Z0-9-]*) exit 2 ;; esac
+  case "$1" in rehearse) rehearse "$2" ;; *) rehearse_locked "$2" ;; esac
+  ;;
  recover)
   job_lock
   "$BB" flock -n "$NATIVE/supervisor.lock" sh "$0" recover-locked 9>&-
