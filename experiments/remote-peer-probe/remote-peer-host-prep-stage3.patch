 unlock:
+	spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+}
+
+void pt_remote_peer_obj_attached(const void *psoc, u8 vdev_id, const u8 *mac)
+{
+	unsigned long flags;
+
+	if (!READ_ONCE(wma_pt_peer_trial.generation))
+		return;
+	spin_lock_irqsave(&wma_pt_peer_lock, flags);
+	if (wma_pt_peer_dp_key_matches(psoc, vdev_id, mac))
+		wma_pt_peer_trial.obj_attached = true;
 	spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
 }
 
