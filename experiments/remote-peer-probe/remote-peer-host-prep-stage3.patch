 	struct dp_pdev *pdev;
 	enum cdp_txrx_ast_entry_type ast_type = CDP_TXRX_AST_TYPE_STATIC;
 	struct dp_vdev *vdev = NULL;
+	bool trial = false;
 
 	if (!peer_mac_addr)
 		return QDF_STATUS_E_FAILURE;
@@ -6070,12 +6071,21 @@
 
 	pdev = vdev->pdev;
 	soc = pdev->soc;
+#ifdef DRIVER_PASSTHRU_OWNER
+	trial = vdev->opmode == wlan_op_mode_passthru &&
+		pt_remote_peer_release_key(soc->ctrl_psoc, vdev_id, peer_mac_addr);
+	if (trial && (peer_type != CDP_LINK_PEER_TYPE ||
+		      !qdf_mem_cmp(peer_mac_addr, vdev->mac_addr.raw, QDF_MAC_ADDR_SIZE))) {
+		dp_vdev_unref_delete(soc, vdev, DP_MOD_ID_CDP);
+		return QDF_STATUS_E_INVAL;
+	}
+#endif
 
 	/*
 	 * If a peer entry with given MAC address already exists,
 	 * reuse the peer and reset the state of peer.
 	 */
-	peer = dp_peer_can_reuse(vdev, peer_mac_addr, peer_type);
+	peer = trial ? NULL : dp_peer_can_reuse(vdev, peer_mac_addr, peer_type);
 
 	if (peer) {
 		qdf_atomic_init(&peer->is_default_route_set);
@@ -6144,7 +6154,7 @@
 
 		dp_vdev_unref_delete(soc, vdev, DP_MOD_ID_CDP);
 		return QDF_STATUS_SUCCESS;
-	} else {
+	} else if (!trial) {
 		/*
 		 * When a STA roams from RPTR AP to ROOT AP and vice versa, we
 		 * need to remove the AST entry which was earlier added as a WDS
@@ -6182,6 +6192,12 @@
 		&peer->mac_addr.raw[0], peer_mac_addr, QDF_MAC_ADDR_SIZE);
 
 	DP_PEER_SET_TYPE(peer, peer_type);
+	/*
+	 * A fresh trial peer must allocate TIDs before publishing the peer
+	 * or taking a vdev CHILD ref. The allocator only needs type/MAC.
+	 */
+	if (trial && QDF_IS_STATUS_ERROR(dp_peer_rx_tids_create(peer)))
+		goto fail;
 	if (IS_MLO_DP_MLD_PEER(peer)) {
 		if (dp_txrx_peer_attach(soc, peer) !=
 				QDF_STATUS_SUCCESS)
@@ -6252,7 +6268,7 @@
 		peer->sta_self_peer = 1;
 	}
 
-	if (dp_peer_rx_tids_create(peer) != QDF_STATUS_SUCCESS) {
+	if (!trial && dp_peer_rx_tids_create(peer) != QDF_STATUS_SUCCESS) {
 		dp_alert("RX tid alloc fail for peer %pK (" QDF_MAC_ADDR_FMT ")",
 			 peer, QDF_MAC_ADDR_REF(peer->mac_addr.raw));
 		goto fail;
@@ -6271,6 +6287,12 @@
 
 	return QDF_STATUS_SUCCESS;
 fail:
+	if (trial) {
+		if (peer->rx_tid)
+			dp_peer_rx_tids_destroy(peer);
+		wlan_minidump_remove(peer, sizeof(*peer), soc->ctrl_psoc,
+				     WLAN_MD_DP_PEER, "dp_peer");
+	}
 	qdf_mem_free(peer);
 	dp_vdev_unref_delete(soc, vdev, DP_MOD_ID_CDP);
 
