@@ -24,6 +24,7 @@
 driver=
 probe=
 paused=0
+flow_triggered=0
 
 bounded() { "$BB" timeout -s TERM -k 2 25 "$@"; }
 check() { echo "$1  $2" | sha256sum -c -; }
@@ -258,7 +259,7 @@
    qca="$ROOT/qca_cld3_kiwi_v2-peer-observer.ko"
    qca_sha=$BA_PEER_OBSERVER_SHA
    ;;
-  remote)
