    qca="$ROOT/qca_cld3_kiwi_v2-remote-peer.ko"
    qca_sha=$(cat "$ROOT/remote-peer.sha")
    test "${#qca_sha}" = 64
@@ -305,16 +306,18 @@
   peer) set -- "$@" pt_ba_observe=1 "pt_ba_peer=$peer" ;;
   caps) set -- "$@" pt_peer_caps_observe=1 ;;
   remote) set -- "$@" pt_peer_caps_observe=1 pt_remote_reo=1 "pt_remote_peer_mac=$peer" ;;
+  remote-flow) set -- "$@" pt_peer_caps_observe=1 pt_remote_reo=1 pt_remote_reo_flow=1 "pt_remote_peer_mac=$peer" ;;
  esac
  bounded insmod "$qca" "$@"
  case "$ba_mode" in
   off) test "$(cat "$W/parameters/pt_ba_observe")" = N ;;
   on|peer) test "$(cat "$W/parameters/pt_ba_observe")" = Y ;;
