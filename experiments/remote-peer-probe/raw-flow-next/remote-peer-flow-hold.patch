+static bool wma_pt_peer_flow_live(void)
+{
+	unsigned long flags;
+	bool live;
+
+	spin_lock_irqsave(&wma_pt_peer_lock, flags);
+	live = wma_pt_peer_live_slot(&wma_pt_peer_trial) &&
+	       !wma_pt_peer_trial.create_conflict &&
+	       !wma_pt_peer_trial.reo_conflict;
+	spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+	return live;
+}
