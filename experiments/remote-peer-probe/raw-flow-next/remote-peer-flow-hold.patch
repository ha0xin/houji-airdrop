+static int wma_pt_peer_flow_stop(const char *value, const struct kernel_param *kp)
+{
+	unsigned long flags;
+	bool stop;
+	int ret;
+
+	ret = kstrtobool(value, &stop);
+	if (ret)
+		return ret;
+	if (!stop || !READ_ONCE(pt_remote_reo_flow))
+		return -EINVAL;
+	spin_lock_irqsave(&wma_pt_peer_lock, flags);
+	if (!wma_pt_peer_trial.flow_ready || wma_pt_peer_trial.flow_stop)
+		ret = -ESHUTDOWN;
+	else
+		wma_pt_peer_trial.flow_stop = true;
+	spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+	return ret;
+}
