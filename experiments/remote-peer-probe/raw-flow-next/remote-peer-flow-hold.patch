+static int wma_pt_peer_hold(struct wlan_objmgr_vdev *vdev,
+			    const struct wma_pt_peer_hold_ops *ops,
+			    void *ctx, bool *delete_safe)
+{
+	void *soc = cds_get_context(QDF_MODULE_ID_SOC);
+	struct wlan_objmgr_pdev *pdev = wlan_vdev_get_pdev(vdev);
+	cdp_config_param_type val;
+	unsigned long flags, deadline;
+	QDF_STATUS status;
+	int ret, drain;
+	bool pending_seen = false;
+
+	*delete_safe = false;
+	if (!ops || !pdev || !soc)
+		return -EINVAL;
+
+	ret = wma_pt_peer_flow_live() ? ops->admit(ctx) : -ESTALE;
+	if (!ret) {
+		deadline = jiffies + msecs_to_jiffies(WMA_PT_FLOW_HOLD_MS);
+		spin_lock_irqsave(&wma_pt_peer_lock, flags);
+		wma_pt_peer_trial.flow_ready = true;
+		wma_pt_peer_trial.flow_opened = true;
+		spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+		while (!READ_ONCE(wma_pt_peer_trial.flow_stop) && !ops->closing(ctx) &&
+		       wma_pt_peer_flow_live() && time_before(jiffies, deadline))
+			usleep_range(8000, 12000);
+		if (ops->closing(ctx))
+			ret = -ESHUTDOWN;
+		else if (!wma_pt_peer_flow_live())
+			ret = -ESTALE;
+		else if (!READ_ONCE(wma_pt_peer_trial.flow_stop))
+			ret = -ETIMEDOUT;
+	}
+	spin_lock_irqsave(&wma_pt_peer_lock, flags);
+	wma_pt_peer_trial.flow_ready = false;
+	wma_pt_peer_trial.flow_status = ret;
+	wma_pt_peer_trial.flow_quiesce_status = -EINPROGRESS;
+	wma_pt_peer_trial.flow_tx_status = -EINPROGRESS;
+	wma_pt_peer_trial.flow_tx_first = U32_MAX;
+	wma_pt_peer_trial.flow_tx_last = U32_MAX;
+	spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+
+	/* Both normal stop and deadline close host admission before any delete. */
+	drain = ops->quiesce(ctx);
+	spin_lock_irqsave(&wma_pt_peer_lock, flags);
+	wma_pt_peer_trial.flow_quiesce_status = drain;
+	wma_pt_peer_trial.flow_cpu_quiet = !drain;
+	spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+	if (drain)
+		return drain;
+
+	/* Exclusive one-pdev mode: include every ordinary raw TX descriptor. */
+	deadline = jiffies + msecs_to_jiffies(WMA_PT_FLOW_TX_DRAIN_MS);
+	drain = -ETIMEDOUT;
+	do {
+		val.cdp_pdev_param_tx_pending = U32_MAX;
+		status = cdp_txrx_get_pdev_param(soc, wlan_objmgr_pdev_get_pdev_id(pdev),
+						CDP_TX_PENDING, &val);
+		if (QDF_IS_STATUS_ERROR(status) || val.cdp_pdev_param_tx_pending == U32_MAX) {
+			drain = QDF_IS_STATUS_ERROR(status) ? qdf_status_to_os_return(status) : -EIO;
+			break;
+		}
+		spin_lock_irqsave(&wma_pt_peer_lock, flags);
+		if (!pending_seen) {
+			wma_pt_peer_trial.flow_tx_first = val.cdp_pdev_param_tx_pending;
+			pending_seen = true;
+		}
+		wma_pt_peer_trial.flow_tx_last = val.cdp_pdev_param_tx_pending;
+		spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+		if (!val.cdp_pdev_param_tx_pending) {
+			drain = 0;
+			break;
+		}
+		usleep_range(3000, 5000);
+	} while (time_before(jiffies, deadline));
+
+	spin_lock_irqsave(&wma_pt_peer_lock, flags);
+	wma_pt_peer_trial.flow_tx_status = drain;
+	wma_pt_peer_trial.flow_tx_quiet = !drain;
+	spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+	*delete_safe = !drain;
+	return drain ? drain : ret;
+}
