+static bool hdd_pt_peer_hold_closing(void *context)
+{
+	struct hdd_pt_owner *owner = context;
+
+	return atomic_read(&owner->closing) || atomic_read(&owner->recovering);
+}
+
+static int hdd_pt_peer_hold_admit(void *context)
+{
+	struct hdd_pt_owner *owner = context;
+	QDF_STATUS status;
+
+	if (hdd_pt_peer_hold_closing(owner))
+		return -ESHUTDOWN;
+	/* Initial matched START is still current; no tune or WMI call here. */
+	status = ucfg_dp_passthru_set_channel(owner->endpoint, owner->frequency);
+	if (QDF_IS_STATUS_ERROR(status))
+		return qdf_status_to_os_return(status);
+	smp_store_release(&owner->active, true);
+	if (hdd_pt_peer_hold_closing(owner)) {
+		smp_store_release(&owner->active, false);
+		return -ESHUTDOWN;
+	}
+	return 0;
+}
+
+static int hdd_pt_peer_hold_quiesce(void *context)
+{
+	struct hdd_pt_owner *owner = context;
+	unsigned long deadline = jiffies + msecs_to_jiffies(500);
+	QDF_STATUS status;
+
+	smp_store_release(&owner->active, false);
+	do {
+		status = ucfg_dp_passthru_pause(owner->endpoint);
+		if (status != QDF_STATUS_E_BUSY)
+			return qdf_status_to_os_return(status);
+		usleep_range(1000, 2000);
+	} while (time_before(jiffies, deadline));
+	return -ETIMEDOUT;
+}
+
+static const struct wma_pt_peer_hold_ops hdd_pt_peer_hold_ops = {
+	.admit = hdd_pt_peer_hold_admit,
+	.closing = hdd_pt_peer_hold_closing,
+	.quiesce = hdd_pt_peer_hold_quiesce,
+};
