+#ifdef DRIVER_PASSTHRU_OWNER
+static bool dp_pt_remote_preserve_self_ast(struct dp_soc *soc,
+					    struct dp_vdev *vdev,
+					    struct dp_peer *remote,
+					    uint16_t peer_id,
+					    uint16_t hw_peer_id, uint16_t ast_hash)
+{
+	struct dp_peer *self, *slot = NULL;
+	uint16_t self_idx, self_hash;
+	bool proven, preserve;
+
+	if (!pt_remote_peer_ast_target(soc->ctrl_psoc, vdev->vdev_id,
+				       remote->mac_addr.raw, peer_id))
+		return false;
+
+	self_idx = vdev->bss_ast_idx;
+	self_hash = vdev->bss_ast_hash;
+	self = dp_peer_find_hash_find(soc, vdev->mac_addr.raw, 0,
+				      vdev->vdev_id, DP_MOD_ID_CDP);
+	if (self && self != remote && self->vdev == vdev && self->valid &&
+	    self->peer_id != HTT_INVALID_PEER && self->peer_id != peer_id)
+		slot = dp_peer_get_ref_by_id(soc, self->peer_id, DP_MOD_ID_CDP);
+	proven = slot && slot == self &&
+		 self->ast_idx == self_idx && self->ast_hash == self_hash;
+	preserve = pt_remote_peer_ast_note_map(soc->ctrl_psoc, vdev->vdev_id,
+			remote->mac_addr.raw, peer_id, proven, self_idx, self_hash,
+			hw_peer_id, ast_hash);
+	if (slot)
+		dp_peer_unref_delete(slot, DP_MOD_ID_CDP);
+	if (self)
+		dp_peer_unref_delete(self, DP_MOD_ID_CDP);
+	return preserve;
+}
+#endif
