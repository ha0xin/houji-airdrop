+bool pt_remote_peer_ast_target(const void *psoc, u8 vdev_id, const u8 *mac,
+			       u16 peer_id)
+{
+	unsigned long flags;
+	bool match;
+
+	if (!READ_ONCE(pt_remote_preserve_self_ast))
+		return false;
+	spin_lock_irqsave(&wma_pt_peer_lock, flags);
+	match = wma_pt_peer_dp_key_matches(psoc, vdev_id, mac) &&
+		wma_pt_peer_trial.slot_installed &&
+		wma_pt_peer_trial.peer_id == peer_id;
+	spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+	return match;
+}
+
+bool pt_remote_peer_ast_note_map(const void *psoc, u8 vdev_id, const u8 *mac,
+				 u16 peer_id, bool self_proven, u16 self_idx,
+				 u16 self_hash, u16 remote_idx, u16 remote_hash)
+{
+	unsigned long flags;
+	bool preserve = false;
+
+	spin_lock_irqsave(&wma_pt_peer_lock, flags);
+	if (!wma_pt_peer_dp_key_matches(psoc, vdev_id, mac) ||
+	    wma_pt_peer_trial.peer_id != peer_id)
+		goto unlock;
+	if (wma_pt_peer_trial.ast_map_seen) {
+		if (wma_pt_peer_trial.ast_self_proven != self_proven ||
+		    wma_pt_peer_trial.ast_self_idx != self_idx ||
+		    wma_pt_peer_trial.ast_self_hash != self_hash ||
+		    wma_pt_peer_trial.ast_remote_idx != remote_idx ||
+		    wma_pt_peer_trial.ast_remote_hash != remote_hash)
+			wma_pt_peer_trial.ast_conflict = true;
+	} else {
+		wma_pt_peer_trial.ast_map_seen = true;
+		wma_pt_peer_trial.ast_self_proven = self_proven;
+		wma_pt_peer_trial.ast_self_idx = self_idx;
+		wma_pt_peer_trial.ast_self_hash = self_hash;
+		wma_pt_peer_trial.ast_remote_idx = remote_idx;
+		wma_pt_peer_trial.ast_remote_hash = remote_hash;
+		wma_pt_peer_trial.ast_distinct = self_idx != remote_idx ||
+			(self_hash & 0xf) != (remote_hash & 0xf);
+	}
+	preserve = wma_pt_peer_trial.ast_self_proven && !wma_pt_peer_trial.ast_conflict;
+unlock:
+	spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+	return preserve;
+}
+
+void pt_remote_peer_ast_note_tx(const void *psoc, u8 vdev_id, u16 idx, u16 hash)
+{
+	unsigned long flags;
+
+	if (!READ_ONCE(pt_remote_preserve_self_ast) || !READ_ONCE(wma_pt_peer_trial.flow_ready))
+		return;
+	spin_lock_irqsave(&wma_pt_peer_lock, flags);
+	if (wma_pt_peer_trial.psoc == psoc && wma_pt_peer_trial.vdev_id == vdev_id &&
+	    wma_pt_peer_trial.flow_ready && wma_pt_peer_trial.ast_self_proven) {
+		if (!wma_pt_peer_trial.ast_tx_samples) {
+			wma_pt_peer_trial.ast_tx_idx = idx;
+			wma_pt_peer_trial.ast_tx_cache = hash & 0xf;
+		}
+		wma_pt_peer_trial.ast_tx_samples++;
+		if (idx != wma_pt_peer_trial.ast_self_idx ||
+		    (hash & 0xf) != (wma_pt_peer_trial.ast_self_hash & 0xf))
+			wma_pt_peer_trial.ast_tx_mismatch++;
+	}
+	spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
 }
 
