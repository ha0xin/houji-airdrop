+static bool wma_pt_peer_flow_key(const void *psoc, u8 vdev_id, u16 peer_id)
+{
+	return wma_pt_peer_trial.flow_ready &&
+	       wma_pt_peer_trial.psoc == psoc &&
+	       wma_pt_peer_trial.vdev_id == vdev_id &&
+	       wma_pt_peer_trial.peer_id == peer_id &&
+	       wma_pt_peer_trial.slot_installed &&
+	       !wma_pt_peer_trial.slot_removed &&
+	       !wma_pt_peer_trial.dp_conflict;
+}
+
+void pt_remote_peer_flow_be_rx(const void *psoc, u8 vdev_id, u16 peer_id,
+			       bool accepted, u32 capacity, u32 cfg, u32 tlv)
+{
+	unsigned long flags;
+
+	if (!READ_ONCE(wma_pt_peer_trial.flow_ready))
+		return;
+	spin_lock_irqsave(&wma_pt_peer_lock, flags);
+	if (wma_pt_peer_flow_key(psoc, vdev_id, peer_id)) {
+		if (accepted)
+			wma_pt_peer_trial.flow_be_pass++;
+		else
+			wma_pt_peer_trial.flow_be_reject++;
+		wma_pt_peer_trial.flow_buf_cfg = cfg;
+		wma_pt_peer_trial.flow_tlv_size = tlv;
+		if (capacity > wma_pt_peer_trial.flow_capacity_max)
+			wma_pt_peer_trial.flow_capacity_max = capacity;
+	}
+	spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+}
+
+u64 pt_remote_peer_flow_raw_key(const void *psoc, u8 vdev_id, u16 peer_id,
+				const u8 *ta)
+{
+	unsigned long flags;
+	u64 generation = 0;
+
+	if (!READ_ONCE(wma_pt_peer_trial.flow_ready))
+		return 0;
+	spin_lock_irqsave(&wma_pt_peer_lock, flags);
+	if (wma_pt_peer_flow_key(psoc, vdev_id, peer_id) &&
+	    !memcmp(wma_pt_peer_trial.mac, ta, QDF_MAC_ADDR_SIZE))
+		generation = wma_pt_peer_trial.generation;
+	spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+	return generation;
+}
+
+void pt_remote_peer_flow_raw_submit(u64 generation)
+{
+	unsigned long flags;
+
+	if (!generation)
+		return;
+	spin_lock_irqsave(&wma_pt_peer_lock, flags);
+	if (generation == wma_pt_peer_trial.generation)
+		wma_pt_peer_trial.flow_raw_qos_submit++;
+	spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
 }
 
