+/* Owner holds its handoff ticket and parent DSC operation, with no RTNL. */
+int wma_pt_remote_peer_run(struct wlan_objmgr_vdev *vdev, u64 generation,
+			  struct qdf_mac_addr *remote, bool *retire)
+{
+	tp_wma_handle wma = cds_get_context(QDF_MODULE_ID_WMA);
+	struct wma_pt_peer_trial trial;
+	unsigned long deadline;
+	QDF_STATUS status;
+	int ret = -ETIMEDOUT;
+	enum wma_pt_peer_result result = WMA_PT_PEER_BLOCKED;
+
+	*retire = false;
+	WRITE_ONCE(wma_pt_peer_result, WMA_PT_PEER_RUNNING);
+	status = wma_pt_peer_create(wma, vdev, generation, remote);
+	deadline = jiffies + msecs_to_jiffies(WMA_PT_PEER_WAIT_MS);
+	wma_pt_peer_snapshot(&trial);
+	if (!trial.create_issued) {
+		do {
+			/* Component create can fail after attachment and self ref. */
+			if ((!trial.obj_attached || trial.obj_released) &&
+			    !trial.dp_conflict && !trial.dp_created) {
+				*retire = true;
+				result = WMA_PT_PEER_HOST_CLEAN;
+				ret = QDF_IS_STATUS_ERROR(status) ?
+				      qdf_status_to_os_return(status) : -EIO;
+				goto done;
+			}
+			usleep_range(3000, 5000);
+			wma_pt_peer_snapshot(&trial);
+		} while (time_before(jiffies, deadline));
+		goto done;
+	}
+
+	do {
+		if (trial.create_returned && wma_pt_peer_live_slot(&trial) &&
+		    (trial.create_confirmed || QDF_IS_STATUS_ERROR(status)))
+			break;
+		if (trial.dp_conflict)
+			goto done;
+		usleep_range(3000, 5000);
+		wma_pt_peer_snapshot(&trial);
+	} while (time_before(jiffies, deadline));
+
+	/* An existing slot may be cleaned even when WMI create timed out. */
+	if (!wma_pt_peer_live_slot(&trial))
+		goto done;
+	status = wma_pt_peer_delete(wma, vdev, generation, remote);
+	if (QDF_IS_STATUS_ERROR(status)) {
+		ret = qdf_status_to_os_return(status);
+		goto done;
+	}
+	deadline = jiffies + msecs_to_jiffies(WMA_PT_PEER_WAIT_MS);
+	do {
+		wma_pt_peer_snapshot(&trial);
+		if (wma_pt_peer_clean_delete(&trial) &&
+		    wma->interfaces[trial.vdev_id].peer_count == 1) {
+			*retire = true;
+			if (trial.compensation || trial.create_conflict) {
+				result = WMA_PT_PEER_COMPENSATED;
+				ret = -EIO;
+			} else {
+				result = WMA_PT_PEER_COMPLETE;
+				ret = 0;
+			}
+			break;
+		}
+		if (trial.dp_conflict)
+			break;
+		usleep_range(3000, 5000);
+	} while (time_before(jiffies, deadline));
+done:
+	WRITE_ONCE(wma_pt_peer_result, result);
+	return ret;
+}
