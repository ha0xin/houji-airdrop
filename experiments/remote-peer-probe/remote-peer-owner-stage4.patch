+#ifndef HOUJI_PT_OWNER_HOST_TEST
+/*
+ * One-shot diagnostic. The registry user and handoff ticket hold the owner,
+ * endpoint and owner-held vdev ref until the WMI/DP work has returned.
+ */
+int hdd_pt_run_remote_peer(struct hdd_pt_registry *registry, u64 generation,
+			   struct qdf_mac_addr *peer)
+{
+	struct hdd_pt_owner *owner;
+	struct hdd_wh_ticket ticket = {0};
+	unsigned long deadline = jiffies + msecs_to_jiffies(500);
+	QDF_STATUS status;
+	bool retire = true;
+	int ret;
+
+	owner = hdd_pt_acquire(registry, generation);
+	if (!owner)
+		return -ENOENT;
+	mutex_lock(&owner->control);
+	if (owner->phase != HDD_PT_ACTIVE || !owner->endpoint || !owner->vdev ||
+	    owner->frequency != 5745 || owner->channel_busy ||
+	    atomic_read(&owner->closing) || atomic_read(&owner->recovering)) {
+		ret = -ESHUTDOWN;
+		goto unlock;
+	}
+	ret = hdd_wh_enter(&owner->gate, generation, &ticket);
+	if (ret)
+		goto unlock;
+	owner->channel_busy = true;
+	smp_store_release(&owner->active, false);
+	mutex_unlock(&owner->control);
+
+	do {
+		if (atomic_read(&owner->closing)) {
+			ret = -ESHUTDOWN;
+			goto finish;
+		}
+		status = ucfg_dp_passthru_pause(owner->endpoint);
+		if (status != QDF_STATUS_E_BUSY)
+			break;
+		usleep_range(1000, 2000);
+	} while (time_before(jiffies, deadline));
+	ret = qdf_status_to_os_return(status);
+	if (!ret && !atomic_read(&owner->closing))
+		ret = wma_pt_remote_peer_run(owner->vdev, generation, peer, &retire);
+
+finish:
+	mutex_lock(&owner->control);
+	hdd_pt_close_owner(owner, "00", 6);
+	if (!retire)
+		hdd_pt_block(owner, ret ? ret : -EUCLEAN);
+	owner->channel_busy = false;
+	hdd_wh_leave(&ticket);
+	hdd_pt_schedule(owner, 0);
+unlock:
+	mutex_unlock(&owner->control);
+	hdd_pt_release(registry);
+	return ret;
+}
+#endif
