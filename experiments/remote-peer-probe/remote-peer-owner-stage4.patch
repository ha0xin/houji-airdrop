+			 trial.peer_id, trial.obj_attached, trial.obj_created, trial.dp_created,
+			 trial.create_issued, trial.create_returned, trial.create_submit,
+			 trial.create_confirmed, trial.create_status, trial.create_duplicates,
+			 trial.create_conflict, trial.htt_map, trial.slot_installed,
+			 trial.delete_issued, trial.delete_returned, trial.delete_submit,
+			 trial.delete_confirmed, trial.delete_duplicates, trial.htt_unmap,
+			 trial.slot_removed, trial.dp_released, trial.obj_released,
