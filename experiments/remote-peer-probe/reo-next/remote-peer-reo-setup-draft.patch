+void pt_remote_peer_reo_step(const void *psoc, u8 vdev_id, const u8 *mac,
+			     enum pt_remote_reo_step step, u32 status, u32 flags)
+{
+	unsigned long lock_flags;
+
+	if (!pt_remote_peer_reo_enabled() || step >= PT_REMOTE_REO_STEPS)
+		return;
+
+	spin_lock_irqsave(&wma_pt_peer_lock, lock_flags);
+	if (wma_pt_peer_dp_key_matches(psoc, vdev_id, mac) &&
+	    wma_pt_peer_trial.reo_setup_issued && wma_pt_peer_trial.slot_installed &&
+	    !wma_pt_peer_trial.delete_issued) {
+		if (wma_pt_peer_trial.reo_steps & BIT(step)) {
+			wma_pt_peer_trial.reo_duplicates++;
+			if (wma_pt_peer_trial.reo_status[step] != status ||
+			    wma_pt_peer_trial.reo_flags[step] != flags)
+				wma_pt_peer_trial.reo_conflict |= BIT(step);
+		} else {
+			wma_pt_peer_trial.reo_status[step] = status;
+			wma_pt_peer_trial.reo_flags[step] = flags;
+			wma_pt_peer_trial.reo_steps |= BIT(step);
+		}
+	}
+	spin_unlock_irqrestore(&wma_pt_peer_lock, lock_flags);
 }
 
