+static void dp_peer_rx_initial_tid_setup(struct dp_peer *peer, int tid, u32 win)
+{
+	QDF_STATUS status = dp_rx_tid_setup_wifi3(peer, BIT(tid), win, 0);
+
+#ifdef DRIVER_PASSTHRU_OWNER
+	struct dp_soc *soc = peer->vdev->pdev->soc;
+	struct dp_rx_tid *rx;
+	u32 flags = 0;
+
+	if (!pt_remote_peer_reo_enabled() || !peer->rx_tid ||
+	    !pt_remote_peer_release_key(soc->ctrl_psoc, peer->vdev->vdev_id,
+					peer->mac_addr.raw))
+		return;
+	rx = &peer->rx_tid[tid];
+
+	qdf_spin_lock_bh(&rx->tid_lock);
+	if (rx->hw_qdesc_vaddr_aligned && rx->hw_qdesc_paddr)
+		flags |= PT_REMOTE_REO_DMA;
+	if (rx->ba_status == DP_RX_BA_INACTIVE)
+		flags |= PT_REMOTE_REO_BA_INACTIVE;
+	if (rx->ba_win_size == 1)
+		flags |= PT_REMOTE_REO_WINDOW_ONE;
+	qdf_spin_unlock_bh(&rx->tid_lock);
+	if (hal_reo_shared_qaddr_is_enable(soc->hal_soc))
+		flags |= PT_REMOTE_REO_QREF_MODE;
+	pt_remote_peer_reo_step(soc->ctrl_psoc, peer->vdev->vdev_id, peer->mac_addr.raw,
+				tid == DP_NON_QOS_TID ? PT_REMOTE_REO_NON_QOS : PT_REMOTE_REO_TID0,
+				status, flags);
+#else
+	(void)status;
+#endif
