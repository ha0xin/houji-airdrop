+u64 pt_remote_peer_reo_key(const void *psoc, u8 vdev_id, const u8 *mac)
+{
+	return pt_remote_peer_reo_enabled() ?
+	       pt_remote_peer_release_key(psoc, vdev_id, mac) : 0;
+}
+
+void pt_remote_peer_reo_binding(u64 generation, enum pt_remote_reo_binding event,
+				u32 mask, u32 status)
+{
+	unsigned long flags;
+	int tid;
+
+	if (!generation)
+		return;
+	spin_lock_irqsave(&wma_pt_peer_lock, flags);
+	if (generation != wma_pt_peer_trial.generation ||
+	    !wma_pt_peer_trial.reo_setup_issued)
+		goto unlock;
+
+	switch (event) {
+	case PT_REMOTE_REO_QUEUE_POSTED:
+		if (status) {
+			wma_pt_peer_trial.reo_queue_error |= mask;
+			break;
+		}
+		wma_pt_peer_trial.reo_queue_posted |= mask;
+		for (tid = 0; tid < 32; tid++)
+			if ((mask & BIT(tid)) && ++wma_pt_peer_trial.reo_posts[tid] != 1)
+				wma_pt_peer_trial.reo_queue_duplicates |= BIT(tid);
+		break;
+	case PT_REMOTE_REO_QUEUE_TAIL:
+		wma_pt_peer_trial.reo_queue_tail |= mask;
+		for (tid = 0; tid < 32; tid++)
+			if ((mask & BIT(tid)) && ++wma_pt_peer_trial.reo_tails[tid] != 1)
+				wma_pt_peer_trial.reo_queue_duplicates |= BIT(tid);
+		if (status)
+			wma_pt_peer_trial.reo_queue_error |= mask;
+		break;
+	case PT_REMOTE_REO_QREF_WRITE:
+		wma_pt_peer_trial.reo_qref_write |= mask;
+		break;
+	case PT_REMOTE_REO_QREF_CLEAR:
+		wma_pt_peer_trial.reo_qref_clear |= mask;
+		break;
+	}
+unlock:
+	spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+}
+
+bool pt_remote_peer_reo_skip_addba(const void *psoc, u8 vdev_id, const u8 *mac)
+{
+	unsigned long flags;
+	bool skip;
+
+	if (!pt_remote_peer_reo_enabled())
+		return false;
+	spin_lock_irqsave(&wma_pt_peer_lock, flags);
+	skip = wma_pt_peer_dp_key_matches(psoc, vdev_id, mac);
+	if (skip)
+		wma_pt_peer_trial.reo_addba_suppressed++;
+	spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+	return skip;
 }
 
