+
+u64 pt_remote_peer_reo_detach(const void *psoc, u8 vdev_id, const u8 *mac,
+			      u8 tid, u64 dma)
+{
+	unsigned long flags;
+	u64 generation = 0;
+	int i;
+
+	if (!pt_remote_peer_reo_enabled() || !dma)
+		return 0;
+	spin_lock_irqsave(&wma_pt_peer_lock, flags);
+	if (!wma_pt_peer_dp_key_matches(psoc, vdev_id, mac) ||
+	    !wma_pt_peer_trial.delete_issued)
+		goto unlock;
+
+	for (i = PT_REMOTE_REO_NON_QOS; i <= PT_REMOTE_REO_TID0; i++) {
+		if (!(wma_pt_peer_trial.reo_steps & BIT(i)) ||
+		    tid != wma_pt_peer_trial.reo_flags[i] >> 8)
+			continue;
+		if (wma_pt_peer_trial.reo_dma[i] != dma ||
+		    (wma_pt_peer_trial.reo_dma_detached & BIT(tid))) {
+			wma_pt_peer_trial.reo_dma_conflict |= BIT(tid);
+			break;
+		}
+		wma_pt_peer_trial.reo_dma_detached |= BIT(tid);
+		generation = wma_pt_peer_trial.generation;
+		break;
+	}
+unlock:
+	spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+	return generation;
+}
+
+void pt_remote_peer_reo_freed(u64 generation, u8 tid, u64 dma,
+			      enum pt_remote_reo_free_path path, u32 flush_status)
+{
+	unsigned long flags;
+	bool first = false;
+	const char *problem = NULL;
+	int i;
+
+	if (!generation || tid >= 32)
+		return;
+	spin_lock_irqsave(&wma_pt_peer_lock, flags);
+	if (generation != wma_pt_peer_trial.generation ||
+	    !(wma_pt_peer_trial.reo_dma_detached & BIT(tid)))
+		goto unlock;
+
+	if (wma_pt_peer_trial.reo_dma_freed & BIT(tid)) {
+		wma_pt_peer_trial.reo_dma_duplicates |= BIT(tid);
+		problem = "duplicate";
+		goto unlock;
+	}
+	for (i = PT_REMOTE_REO_NON_QOS; i <= PT_REMOTE_REO_TID0; i++) {
+		if (tid != wma_pt_peer_trial.reo_flags[i] >> 8 ||
+		    wma_pt_peer_trial.reo_dma[i] != dma)
+			continue;
+		wma_pt_peer_trial.reo_dma[i] = 0;
+		wma_pt_peer_trial.reo_dma_freed |= BIT(tid);
+		first = true;
+		break;
+	}
+	if (!first) {
+		wma_pt_peer_trial.reo_dma_conflict |= BIT(tid);
+		problem = "conflict";
+	}
+unlock:
+	spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+	if (first)
+		pr_info("PT_REO_DMA_FREE generation=%llu tid=%u path=%u flush_status=%u\n",
+			generation, tid, path, flush_status);
+	if (problem)
+		pr_info("PT_REO_DMA_ERROR generation=%llu tid=%u error=%s\n", generation, tid, problem);
 }
 
