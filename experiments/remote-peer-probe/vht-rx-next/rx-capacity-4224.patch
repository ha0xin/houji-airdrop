+static inline QDF_STATUS
+dp_rx_map_buffer(qdf_device_t dev, qdf_nbuf_t nbuf, qdf_dma_dir_t dir,
+		 uint16_t size)
+{
+#ifdef DRIVER_PASSTHRU_DP
+	if (unlikely(size == WLAN_CFG_PT_RX_CAPACITY)) {
+		unsigned int available = qdf_nbuf_tailroom(nbuf);
+		QDF_STATUS status;
+
+		if (qdf_nbuf_is_nonlinear(nbuf) || available < size) {
+			pr_warn_ratelimited("PT_RX_CAPACITY map_short bytes=%u linear=%u\n",
+					    size, available);
+			return QDF_STATUS_E_INVAL;
+		}
+
+		status = qdf_nbuf_map_nbytes_single(dev, nbuf, dir, size);
+		if (QDF_IS_STATUS_SUCCESS(status))
+			pr_info_once("PT_RX_CAPACITY map_bytes=%u linear=%u\n",
+				     size, available);
+		else
+			pr_warn_ratelimited("PT_RX_CAPACITY map_failed bytes=%u status=%d\n",
+					    size, status);
+		return status;
+	}
+#endif
+	return qdf_nbuf_map_nbytes_single(dev, nbuf, dir, size);
+}
 
