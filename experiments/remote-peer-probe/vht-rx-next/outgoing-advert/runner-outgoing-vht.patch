+    fn report_first_submitted_mif(&mut self, bytes: &[u8]) {
+        use owly_awdl::{frame, tlv};
+
+        if self.mif_reported || bytes.first() != Some(&0xd0) {
+            return;
+        }
+        let Ok(frame::Received::Action { subtype: frame::subtype::MIF, tlvs, .. }) =
+            frame::parse(bytes)
+        else {
+            return;
+        };
+        let mut container = None;
+        for entry in tlv::tlvs(tlvs) {
+            let Ok(entry) = entry else { return };
+            if entry.kind == tlv::kind::IEEE80211_CONTAINER &&
+                container.replace(entry.value).is_some()
+            {
+                return;
+            }
+        }
+        let wire = container.map_or_else(
+            || "absent".to_owned(),
+            |value| value.iter().map(|byte| format!("{byte:02x}")).collect::<String>(),
+        );
+        println!("OWLY_MIF_SUBMITTED_VHT_CONTAINER={wire}");
+        self.mif_reported = true;
     }
 }
 
