+fn outgoing_vht_enabled() -> io::Result<bool> {
+    match std::env::var("HOUJI_OWLY_OUTGOING_VHT") {
+        Err(std::env::VarError::NotPresent) => Ok(false),
+        Ok(value) if value == "0" => Ok(false),
+        Ok(value) if value == "1" => {
+            let capacity = fs::read_to_string(
+                "/sys/module/qca_cld3_kiwi_v2/parameters/pt_rx_capacity_4224",
+            )?;
+            let vht = fs::read_to_string("/sys/module/qca_cld3_kiwi_v2/parameters/pt_vht80")?;
+            if capacity.trim() != "Y" || vht.trim() != "Y" {
+                return Err(io::Error::other(
+                    "outgoing VHT requires the tested RX capacity and VHT80 radio mode",
+                ));
+            }
+            Ok(true)
+        }
+        _ => Err(io::Error::other("expected HOUJI_OWLY_OUTGOING_VHT=0 or 1")),
+    }
+}
