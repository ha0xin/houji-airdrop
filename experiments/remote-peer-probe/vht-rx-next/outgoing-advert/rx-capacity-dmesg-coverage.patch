+def kernel_log_timestamps(rows, first, last):
+    stamps = []
+    for row in rows:
+        match = re.match(r"^\[\s*(\d+\.\d+)\]", row)
+        if not match:
+            return None
+        stamp = float(match.group(1))
+        if not first <= stamp <= last or (stamps and stamp < stamps[-1]):
+            return None
+        stamps.append(stamp)
+    return stamps
 
 
