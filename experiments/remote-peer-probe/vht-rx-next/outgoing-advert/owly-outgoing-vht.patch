+fn put_vht80_1ss_capabilities(out: &mut Vec<u8>) {
+    const VHT_CAPABILITIES_IE: u8 = 191;
+    const CAPABILITIES_LEN: u8 = 12;
+    const MCS_1SS_0_TO_7: u16 = 0xfffc;
+
+    tlv(out, kind::IEEE80211_CONTAINER, |v| {
+        v.u8(VHT_CAPABILITIES_IE);
+        v.u8(CAPABILITIES_LEN);
+        // Max MPDU 3895, base 80 MHz support, optional VHT feature bits clear.
+        v.le32(0);
+        v.le16(MCS_1SS_0_TO_7); // RX MCS, NSS 2–8 unsupported
+        v.le16(0); // RX highest data rate unspecified
+        v.le16(MCS_1SS_0_TO_7); // TX MCS, NSS 2–8 unsupported
+        v.le16(0); // TX highest data rate unspecified
+    });
+}
