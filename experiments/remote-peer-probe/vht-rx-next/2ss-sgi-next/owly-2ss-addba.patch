+fn put_vht80_2ss_sgi_capabilities(out: &mut Vec<u8>, max_ampdu_exp: u8) {
+    const VHT_CAPABILITIES_IE: u8 = 191;
+    const CAPABILITIES_LEN: u8 = 12;
+    const VHT_CAP_RX_LDPC_SGI80_MPDU3895: u32 = 0x0000_0030;
+    const MCS_2SS_0_TO_9: u16 = 0xfffa;
+
+    let cap = VHT_CAP_RX_LDPC_SGI80_MPDU3895 | (((max_ampdu_exp as u32) & 0x7) << 23);
+    tlv(out, kind::IEEE80211_CONTAINER, |v| {
+        v.u8(VHT_CAPABILITIES_IE);
+        v.u8(CAPABILITIES_LEN);
+        v.le32(cap);
+        v.le16(MCS_2SS_0_TO_9); // RX MCS, NSS 1–2 MCS 0–9, NSS 3–8 unsupported
+        v.le16(0); // RX highest data rate unspecified
+        v.le16(MCS_2SS_0_TO_9); // TX MCS, NSS 1–2 MCS 0–9, NSS 3–8 unsupported
+        v.le16(0); // TX highest data rate unspecified
+    });
