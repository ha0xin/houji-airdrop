+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct PureTcpAck {
+    pub src: Ipv6Addr,
+    pub dst: Ipv6Addr,
+    pub src_port: u16,
+    pub dst_port: u16,
+    pub seq: u32,
+    pub ack: u32,
+    pub window: u16,
+    pub simple_options: bool,
+}
+
+impl PureTcpAck {
+    pub fn flow(&self) -> (Ipv6Addr, Ipv6Addr, u16, u16) {
+        (self.src, self.dst, self.src_port, self.dst_port)
+    }
+
+    /// Whether `self` is a strictly newer cumulative ACK on the same flow
+    /// with no SACK/non-timestamp options and nonzero windows on both sides.
+    pub fn supersedes(&self, earlier: &PureTcpAck) -> bool {
+        if self.flow() != earlier.flow()
+            || self.seq != earlier.seq
+            || !self.simple_options
+            || !earlier.simple_options
+            || self.window == 0
+            || earlier.window == 0
+        {
+            return false;
+        }
+        let delta = self.ack.wrapping_sub(earlier.ack);
+        delta > 0 && delta < 0x8000_0000
+    }
+}
+
+fn simple_tcp_options(mut opts: &[u8]) -> bool {
+    while let Some(&kind) = opts.first() {
+        match kind {
+            0 => return true,
+            1 => opts = &opts[1..],
+            8 => {
+                if opts.len() < 10 || opts[1] != 10 {
+                    return false;
+                }
+                opts = &opts[10..];
+            }
+            _ => return false,
+        }
+    }
+    true
+}
