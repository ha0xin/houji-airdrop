+    }
+    let mut actual: libc::c_int = 0;
+    let mut len: libc::socklen_t = size_of::<libc::c_int>() as _;
+    syscall(
+        unsafe {
+            libc::getsockopt(
+                raw,
+                libc::SOL_SOCKET,
+                std_opt,
+                (&raw mut actual).cast(),
+                &raw mut len,
+            )
+        }
+        as libc::ssize_t,
+    )?;
+    Ok(actual)
