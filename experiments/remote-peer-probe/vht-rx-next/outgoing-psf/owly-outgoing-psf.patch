+#[test]
+fn node_adds_vht_only_to_the_selected_action_subtypes() {
+    fn own_actions(scope: OutgoingVht) -> [Vec<u8>; 2] {
+        let radio = RadioConstraints {
+            channel: Channel(149),
+            presence: Presence::Fixed,
+        };
+        let mut cfg = Config::new(US, "owly", radio);
+        cfg.outgoing_vht = scope;
+        let mut n = Node::new(cfg, START);
+        let actions = tick(&mut n, START.plus(200 * TU));
+        let mut frames = [None, None];
+        for sent in transmits(&actions) {
+            let Ok(frame::Received::Action { subtype, .. }) = frame::parse(&sent.bytes) else {
+                continue;
+            };
+            match subtype {
+                subtype::PSF => frames[0] = Some(sent.bytes.clone()),
+                subtype::MIF => frames[1] = Some(sent.bytes.clone()),
+                _ => {}
+            }
+        }
+        frames.map(|frame| frame.expect("timer sent its own action"))
+    }
+
+    let [off_psf, off_mif] = own_actions(OutgoingVht::Off);
+    let [mif_psf, mif_mif] = own_actions(OutgoingVht::Mif);
+    let [both_psf, both_mif] = own_actions(OutgoingVht::PsfAndMif);
+    assert_eq!(off_psf, mif_psf);
+    assert_eq!(mif_mif, both_mif);
+
+    let wire = [17, 14, 0, 191, 12, 0, 0, 0, 0, 0xfc, 0xff, 0, 0, 0xfc, 0xff, 0, 0];
+    for (off, mut on) in [(off_psf, both_psf), (off_mif, mif_mif)] {
+        let start = on.windows(wire.len()).position(|bytes| bytes == wire).unwrap();
+        on.drain(start..start + wire.len());
+        assert_eq!(off, on);
+    }
+}
