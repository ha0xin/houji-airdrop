+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum OutgoingVht {
+    Off,
+    Mif,
+    PsfAndMif,
+}
+
+impl OutgoingVht {
+    fn advertises(self, subtype: u8) -> bool {
+        matches!(
+            (self, subtype),
+            (Self::Mif | Self::PsfAndMif, frame::subtype::MIF)
+                | (Self::PsfAndMif, frame::subtype::PSF)
+        )
+    }
+}
+
+#[cfg(test)]
+#[test]
+fn outgoing_vht_scope() {
+    use frame::subtype::{MIF, PSF};
+
+    assert!(!OutgoingVht::Off.advertises(PSF));
+    assert!(!OutgoingVht::Off.advertises(MIF));
+    assert!(!OutgoingVht::Mif.advertises(PSF));
+    assert!(OutgoingVht::Mif.advertises(MIF));
+    assert!(OutgoingVht::PsfAndMif.advertises(PSF));
+    assert!(OutgoingVht::PsfAndMif.advertises(MIF));
+    assert!(!OutgoingVht::PsfAndMif.advertises(0xff));
+}
