+/* Capture the first remote-index selection only. No per-packet logging or
+ * steady-state lock: immutable until module reload, protected for publication.
+ */
+struct pt_ast_selection_snapshot {
+	bool valid;
+	u8 vdev_id;
+	u16 bss_index, bss_hash, remote_index, remote_hash;
+	u16 selected_index, selected_hash;
+};
+static struct pt_ast_selection_snapshot pt_ast_selection;
+static DEFINE_SPINLOCK(pt_ast_selection_lock);
