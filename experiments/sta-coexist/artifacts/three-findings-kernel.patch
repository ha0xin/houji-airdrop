+static void pt_record_ast_selection(struct dp_vdev *vdev,
+				    struct dp_tx_msdu_info_s *msdu_info,
+				    u16 selected_index, u16 selected_hash)
+{
+	unsigned long flags;
+
+	if (READ_ONCE(pt_ast_selection.valid))
+		return;
+	spin_lock_irqsave(&pt_ast_selection_lock, flags);
+	if (!pt_ast_selection.valid) {
+		pt_ast_selection.vdev_id = vdev->vdev_id;
+		pt_ast_selection.bss_index = vdev->bss_ast_idx;
+		pt_ast_selection.bss_hash = vdev->bss_ast_hash;
+		pt_ast_selection.remote_index = msdu_info->passthru_ast_idx;
+		pt_ast_selection.remote_hash = msdu_info->passthru_ast_hash;
+		pt_ast_selection.selected_index = selected_index;
+		pt_ast_selection.selected_hash = selected_hash;
+		WRITE_ONCE(pt_ast_selection.valid, true);
+	}
+	spin_unlock_irqrestore(&pt_ast_selection_lock, flags);
+}
