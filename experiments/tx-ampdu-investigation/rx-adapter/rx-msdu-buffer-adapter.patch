+#ifdef DRIVER_PASSTHRU_DP
+/*
+ * False: no ownership changes; use the unchanged legacy exception handler.
+ * True: descriptor reclaimed exactly once, nbuf consumed, *lmac_id replenishes
+ * exactly one RX buffer. No fallback is allowed after DMA unmap/detachment.
+ * Deliberately no unverified metadata-bit or unknown-peer/vdev-list fallback.
+ */
+static bool dp_rx_err_try_passthru_msdu_buf(struct dp_soc *soc,
+					 hal_ring_desc_t ring_desc,
+					 struct hal_rx_mpdu_desc_info *info,
+					 int *lmac_id)
+{
+	dp_txrx_ref_handle peer_ref = NULL;
+	struct dp_txrx_peer *peer;
+	struct dp_vdev *vdev = NULL;
+	struct dp_rx_desc *rx_desc;
+	struct rx_desc_pool *pool;
+	struct dp_pdev *pdev;
+	struct hal_buf_info hbi;
+	qdf_nbuf_t nbuf;
+	uint16_t peer_id;
+	uint32_t mapped_size;
+	enum dp_pt_rx_msdu_result result;
+
+	if (!pt_rx_msdu_buf)
+		return false;
+	atomic_inc(&pt_rx_msdu_seen);
+	peer_id = dp_rx_peer_metadata_peer_id_get(soc, info->peer_meta_data);
+	peer = dp_tgt_txrx_peer_get_ref_by_id(soc, peer_id, &peer_ref,
+					    DP_MOD_ID_RX_ERR);
+	if (peer) {
+		if (peer->vdev && peer->vdev->opmode == wlan_op_mode_passthru &&
+		    !QDF_IS_STATUS_ERROR(dp_vdev_get_ref(soc, peer->vdev,
+							 DP_MOD_ID_RX_ERR)))
+			vdev = peer->vdev;
+		dp_txrx_peer_unref_delete(peer_ref, DP_MOD_ID_RX_ERR);
+	}
+	if (!vdev) {
+		atomic_inc(&pt_rx_msdu_miss);
+		return false;
+	}
+
+	hal_rx_reo_buf_paddr_get(soc->hal_soc, ring_desc, &hbi);
+	rx_desc = dp_rx_cookie_2_va_rxdma_buf(soc, hbi.sw_cookie);
+	if (!rx_desc || !rx_desc->nbuf || !rx_desc->in_use ||
+	    rx_desc->pool_id >= MAX_RXDESC_POOLS ||
+	    rx_desc->pool_id >= MAX_PDEV_CNT)
+		goto legacy;
+	nbuf = rx_desc->nbuf;
+	if (hbi.paddr != qdf_nbuf_get_frag_paddr(nbuf, 0))
+		goto legacy;
+	pdev = dp_get_pdev_for_lmac_id(soc, rx_desc->pool_id);
+	if (!pdev || pdev != vdev->pdev)
+		goto legacy;
+	pool = &soc->rx_desc_buf[rx_desc->pool_id];
+	mapped_size = pool->buf_size;
+	*lmac_id = rx_desc->pool_id;
+	dp_rx_err_ring_record_entry(soc, hbi.paddr, hbi.sw_cookie,
+				    hal_rx_ret_buf_manager_get(soc->hal_soc,
+							       ring_desc));
+	dp_ipa_rx_buf_smmu_mapping_lock(soc);
+	if (rx_desc->unmapped) {
+		dp_ipa_rx_buf_smmu_mapping_unlock(soc);
+		goto legacy;
+	}
+	dp_rx_nbuf_unmap_pool(soc, pool, nbuf);
+	rx_desc->unmapped = 1;
+	dp_ipa_rx_buf_smmu_mapping_unlock(soc);
+
+	/* This helper clears nbuf/in_use and owns the free-list insertion. */
+	dp_rx_add_to_free_desc_list(&pdev->free_list_head,
+				  &pdev->free_list_tail, rx_desc);
+	atomic_inc(&pt_rx_msdu_reaped);
+	if (info->msdu_count != 1 || (info->mpdu_flags & HAL_MPDU_F_FRAGMENT)) {
+		dp_rx_nbuf_free(nbuf);
+		result = DP_PT_RX_MSDU_UNSUPPORTED_MPDU;
+	} else {
+		result = dp_rx_passthru_msdu_buf_deliver(soc, vdev, nbuf,
+							 mapped_size);
+	}
+	if (result == DP_PT_RX_MSDU_DELIVERED) {
+		atomic_inc(&pt_rx_msdu_delivered);
+	} else {
+		atomic_set(&pt_rx_msdu_last_drop, result);
+		atomic_inc(&pt_rx_msdu_dropped);
+	}
+	dp_vdev_unref_delete(soc, vdev, DP_MOD_ID_RX_ERR);
+	return true;
+legacy:
+	atomic_inc(&pt_rx_msdu_bad_desc);
+	dp_vdev_unref_delete(soc, vdev, DP_MOD_ID_RX_ERR);
+	return false;
+}
+#endif
