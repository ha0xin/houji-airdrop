+/// The IEEE 802.11 container holds standard id/length/value IEs.
+fn vht_max_mpdu(mut ies: &[u8]) -> Option<usize> {
+    const VHT_CAPABILITIES: u8 = 191;
+    let mut limit = None;
+    while !ies.is_empty() {
+        let (&id, rest) = ies.split_first()?;
+        let (&len, rest) = rest.split_first()?;
+        let (body, tail) = rest.split_at_checked(usize::from(len))?;
+        if id == VHT_CAPABILITIES {
+            if body.len() != 12 || limit.is_some() {
+                return None;
+            }
+            let capability = u32::from_le_bytes(body[..4].try_into().ok()?);
+            limit = Some(match capability & 0x3 {
+                0 => 3895,
+                1 => 7991,
+                2 => 11454,
+                _ => return None,
+            });
+        }
+        ies = tail;
+    }
+    limit
 }
 
