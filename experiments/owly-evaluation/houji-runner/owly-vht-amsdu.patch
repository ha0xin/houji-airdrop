+#[cfg(test)]
+mod vht_amsdu_tests {
+    use super::*;
+
+    #[test]
+    fn vht_limit_accounts_for_mpdu_headers_and_falls_back() {
+        let local = MacAddr([2, 0, 0, 0, 0, 1]);
+        let remote = MacAddr([2, 0, 0, 0, 0, 2]);
+        let now = Time(1);
+        let mut cfg = Config::new(local, "test", RadioConstraints {
+            channel: Channel(149), presence: Presence::Fixed,
+        });
+        let mut peer = Peer::new(remote, now);
+        cfg.max_frame = 12000;
+        peer.ht = Some(HtCapabilities::ONE_STREAM);
+        peer.vht_max_mpdu = Some((now, 11454));
+        assert_eq!(Node::amsdu_limit(&cfg, &peer, now), 3839);
+        cfg.vht_amsdu = true;
+        for limit in [3895, 7991, 11454] {
+            peer.vht_max_mpdu = Some((now, limit));
+            assert_eq!(Node::amsdu_limit(&cfg, &peer, now) + 26 + 4, limit);
+        }
+        cfg.max_frame = 7935;
+        assert_eq!(Node::amsdu_limit(&cfg, &peer, now) + 26, 7935);
+        assert_eq!(Node::amsdu_limit(&cfg, &peer, now.plus(PEER_TIMEOUT_US + 1)), 3839);
+        peer.vht_max_mpdu = None;
+        assert_eq!(Node::amsdu_limit(&cfg, &peer, now), 3839);
+    }
