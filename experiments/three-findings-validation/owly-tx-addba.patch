+/// QoS Data (TID 0, Normal Ack) frame carrying a single IPv6 packet, so TQM
+/// can aggregate single-MSDU packets into outbound A-MPDUs without non-QoS holes.
+pub fn qos_data_frame(
+    src: MacAddr,
+    dst: MacAddr,
+    seq: u16,
+    awdl_seq: u16,
+    packet: &[u8],
+) -> Vec<u8> {
