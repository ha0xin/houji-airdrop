+/// Outbound IEEE 802.11 Block Ack ADDBA Request (Category 3, Action 0).
+pub fn addba_request(
+    src: MacAddr,
+    dst: MacAddr,
+    seq: u16,
+    token: u8,
+    tid: u8,
+    window: u16,
+    allow_amsdu: bool,
+    ssn: u16,
+) -> Vec<u8> {
+    let win = window.clamp(1, 256);
+    let amsdu_bit = u16::from(allow_amsdu);
+    let params = amsdu_bit | 0x0002 | ((u16::from(tid) & 0x0f) << 2) | (win << 6);
+    let mut out = Vec::with_capacity(HEADER_LEN + 9);
+    put_header(&mut out, fc::ACTION, dst, src, seq);
+    out.u8(CATEGORY_BLOCK_ACK);
+    out.u8(ADDBA_REQUEST);
+    out.u8(token);
+    out.le16(params);
+    out.le16(0); // Block Ack timeout = 0 (no inactivity timer)
+    out.le16((ssn & 0x0fff) << 4); // Block Ack Starting Sequence Control
+    out
+}
