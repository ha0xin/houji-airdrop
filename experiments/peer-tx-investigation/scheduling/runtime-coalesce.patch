+}
+
+#[test]
+fn configured_hold_controls_deadline_without_losing_the_packet() {
+    for hold in [0, 250, 1_000, 4_000] {
+        let mut node = coalescing_node_with_delay(7935, hold);
+        let now = meet(&mut node, &seq([149; SLOTS])).plus(100);
+        let packet = Ipv6Packet::echo_request(US, PHONE, 5, 1, &[1; 600]);
+        let expected = vec![packet.data.clone()];
+        let first = outgoing(&mut node, now, packet);
+        if hold == 0 {
+            assert_eq!(phone_payloads(&first), expected);
+        } else {
+            assert!(phone_payloads(&first).is_empty());
+            assert!(phone_payloads(&tick(&mut node, now.plus(hold - 1))).is_empty());
+            assert_eq!(phone_payloads(&tick(&mut node, now.plus(hold))), expected);
+        }
+        assert_eq!(node.backlog(), 0);
+    }
 }
 
